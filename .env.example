# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# "claude_cli" uses your Claude plan via the Claude Code CLI (claude -p).
# "anthropic_api" uses the paid API and needs ANTHROPIC_API_KEY.
LLM_BACKEND=claude_cli
# Leave blank to auto-detect (PATH, ~/.local/bin, or the Claude desktop app's bundled CLI).
CLAUDE_CLI_PATH=
# Run `claude setup-token` once and paste the token here so the bot can use your plan in the background.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Telegram (create a bot with @BotFather, then message it and run `resumebot telegram-chat-id`) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dedicated Gmail for applications (Google Account > Security > App passwords) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- GitHub (token optional; needed only for private repos) ---
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
